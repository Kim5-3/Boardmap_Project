# Copy this file to .env, then configure both required values locally.
# DATABASE_URL=postgresql+psycopg://<application_role>:<password>@localhost:5432/boardmap_db
# JWT_SECRET_KEY=<random secret of at least 32 characters>
ACCESS_TOKEN_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://127.0.0.1:5000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

AUTO_CREATE_TABLES=false

# Private issue-report attachments (never served from the public /uploads path).
# Defaults to ../private_reports relative to this repository.
# REPORT_UPLOAD_DIR=C:/var/lib/boardmap/private_reports
